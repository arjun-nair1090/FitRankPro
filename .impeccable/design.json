  "narrative": {
    "northStar": "The Lit Scoreboard",
    "overview": "FitRank is a training log you read in a dim gym between sets, one-handed, then study at a desk later. The ground is near-black, every unit of content sits on a slightly lifted card with a hairline seam, and a single blue carries every action and every line of data. Nothing glows, nothing is glass; the drama comes from numbers.",
    "keyCharacteristics": [
      "Near-black ground, flat cards separated by 1px seams rather than shadows.",
      "One accent (signal blue) for actions, active navigation and every chart line.",
      "State colors only for state: done green, record amber, stop red.",
      "Platform UI type with tabular numerals; figures are the loudest thing on screen.",
      "Motion that draws data in once per route, never on re-render."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Signal blue is the only hue that means act or data. New series are drawn as lighter or dimmer blue.",
        "section": "colors"
      },
      {
        "name": "The State-Only Rule",
        "body": "Green, amber and red appear only when something is done, a record, a warning or destructive.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number on screen uses tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Seam Not Shadow Rule",
        "body": "Cards are separated by a 1px seam and a tonal step, never by a shadow.",
        "section": "elevation"
      }
    ]
  }
